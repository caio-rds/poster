# cPanel: use a URI atual do MongoDB Atlas (Connect > Drivers).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=zion
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Obrigatória para iniciar a API; envie no header apikey.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Origens de frontend permitidas (JSON, sem barra final).
CORS_ALLOW_ORIGINS=["https://zionsoftwarehouse.com.br","https://www.zionsoftwarehouse.com.br"]
CORS_MAX_AGE=600
WORKER_INTERVAL_SECONDS=3600
# Inicia em segundo plano junto com a API/Passenger.
WORKER_ENABLED=true
WORKER_RETRY_SECONDS=30
CRAWL_MAX_PAGES=100
CRAWL_MAX_DEPTH=3
CRAWL_DELAY_SECONDS=1
MAX_BLOG_ARTICLES=30
SIMILARITY_THRESHOLD=0.86
# API do Instagram com Instagram Login (conta profissional autorizada).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v25.0
# false: permite site/blog sem credenciais. true: exige Instagram antes de gerar posts.
INSTAGRAM_REQUIRED=false
INSTAGRAM_MAX_PAGES=20
